  }

  .analytics-consent-settings__toggle[aria-checked="true"] {
    background: var(--color-accent-strong);
  }

  .analytics-consent-settings__toggle[aria-checked="true"]::before {
    transform: translateX(1.25rem);
  }

  @media (width <= 30rem) {
    .analytics-consent-settings__item {
      grid-template-columns: minmax(0, 1fr);
    }

    .analytics-consent-settings__toggle {
      justify-self: end;
