<section class="analytics-consent-settings">
  <h3 class="analytics-consent-settings__heading">計測のカスタマイズ</h3>
  <p class="analytics-consent-settings__lead">
    以下の設定をオン・オフすることで、計測内容を変更できます。<br
    />設定はいつでも変更できます。
  </p>
  <div class="analytics-consent-settings__item">
    <div class="analytics-consent-settings__content">
      <p
        id="analytics-consent-settings-title"
        class="analytics-consent-settings__title"
      >
        アクセス解析（Google Analytics）
      </p>
      <p
        id="analytics-consent-settings-description"
        class="analytics-consent-settings__description"
      >
        サイトの利用状況を分析し、改善に役立てます。
      </p>
    </div>
    <button
      class="analytics-consent-settings__toggle"
      type="button"
      role="switch"
      aria-checked="false"
      aria-labelledby="analytics-consent-settings-title"
      aria-describedby="analytics-consent-settings-description"
      data-analytics-consent-toggle></button>
  </div>
</section>

<script is:inline>
  const storageKey = "workingcorgi-analytics-consent";
  const granted = "granted";
  const denied = "denied";
  const toggle = document.querySelector("[data-analytics-consent-toggle]");

  const readConsent = () => {
    try {
      return localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };

  const saveConsent = (consent) => {
    try {
      localStorage.setItem(storageKey, consent);
    } catch {
      return;
    }
  };

  let consent = readConsent();

  const update = () =>
    toggle?.setAttribute("aria-checked", String(consent === granted));

  const syncConsent = (value) => {
    consent = value === granted || value === denied ? value : null;
    update();
  };

  update();

  toggle?.addEventListener("click", () => {
    syncConsent(consent === granted ? denied : granted);

    saveConsent(consent);
    window.dispatchEvent(
      new CustomEvent("analytics-consent-change", { detail: consent }),
    );
  });
  window.addEventListener("analytics-consent-change", (event) => {
    syncConsent(event.detail);
  });
  window.addEventListener("storage", (event) => {
    if (
      event.storageArea !== localStorage ||
      (event.key !== storageKey && event.key !== null)
    ) {
      return;
    }

    syncConsent(event.newValue);
  });
</script>

