---
import { noteCategoryOgps } from "../../config/noteCategoryOgps";
import { site } from "../../config/site";
import GiscusComments from "../../components/GiscusComments.astro";
import NoteMeta from "../../components/NoteMeta.astro";
import {
  getDiscussionArticles,
  renderDiscussionArticleBody,
} from "../../data/discussionArticles";
import type { DiscussionArticle } from "../../domain/discussionArticle";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const notes = await getDiscussionArticles();

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props as { readonly note: DiscussionArticle };
const discussionArticleHtml = await renderDiscussionArticleBody(note);
const categoryOgp = noteCategoryOgps[note.category];
const ogImage = categoryOgp?.image;
const ogImageAlt = categoryOgp?.imageAlt;
---

<Layout
  title={note.title + " | " + site.name}
  description={note.description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <article class="note">
    <a class="note__back-link" href={`${import.meta.env.BASE_URL}notes/`}>
      ← Notes 一覧へ戻る
    </a>

    <header class="note__header">
      <NoteMeta
        category={note.category}
        pubDate={note.pubDate}
        updatedDate={note.updatedDate}
        showDateLabel
        showUpdatedDate
      />
      <h1 class="note__title">{note.title}</h1>
      <p class="note__description">{note.description}</p>
    </header>

    <div class="note__content" set:html={discussionArticleHtml} />

    <GiscusComments
      discussion={{
        number: note.discussionNumber,
        category: note.discussionCategory,
      }}
    />

    <footer class="note__footer">
      <a class="note__back-link" href={`${import.meta.env.BASE_URL}notes/`}>
        ← Notes 一覧へ戻る
      </a>
    </footer>
  </article>
</Layout>

<style lang="scss">
  .note {
    max-width: 50rem;
    margin-inline: auto;
  }

  .note__back-link {
    display: inline-flex;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-link);
    text-underline-offset: 0.18em;
  }

  .note__header {
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .note__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
  }

  .note__description {
    margin: var(--space-md) 0 0;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .note__content {
    padding: var(--space-xl);
    line-height: 1.9;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .note__content > :global(:first-child) {
    margin-top: var(--space-xs);
  }

  .note__content > :global(:last-child) {
    margin-bottom: var(--space-xs);
  }

  .note__content :global(h2) {
    padding-bottom: var(--space-xs);
    margin-top: var(--space-2xl);
    font-size: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .note__content :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .note__content :global(.heading-anchor) {
    margin-left: var(--space-xs);
    font-size: 0.8em;
    color: var(--color-text-muted);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .note__content :global(h2:hover .heading-anchor),
  .note__content :global(h3:hover .heading-anchor),
  .note__content :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  .note__content :global(p),
  .note__content :global(ul) {
    margin-block: var(--space-md);
  }

  .note__content :global(ul) {
    padding-left: 1.5em;
  }

  .note__content :global(li::marker) {
    color: var(--color-accent-strong);
  }

  .note__content :global(a) {
    color: var(--color-link);
    text-decoration-line: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.13em;
  }

  .note__content :global(blockquote) {
    padding: var(--space-md) var(--space-lg);
    margin: var(--space-xl) 0;
    color: var(--color-text);
    background: var(--color-accent-soft);
    border-left: 0.25rem solid var(--color-accent-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .note__content :global(blockquote p) {
    margin-block: 0;
  }

  .note__content :global(table) {
    width: 100%;
    margin-block: var(--space-xl);
    overflow: hidden;
    font-size: 0.9375rem;
    border-spacing: 0;
    border-collapse: separate;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .note__content :global(th),
  .note__content :global(td) {
    padding: var(--space-sm) var(--space-md);
    vertical-align: top;
    text-align: left;
  }

  .note__content :global(th) {
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-accent-soft);
  }

  .note__content :global(td) {
    border-top: 1px solid var(--color-border);
  }

  .note__content :global(strong) {
    color: var(--color-accent-strong);
  }

  .note__content :global(code) {
    padding: 0.1em 0.35em;
    font-size: 0.875em;
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .note__footer {
    padding-top: var(--space-lg);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  @media (width <= 30rem) {
    .note__content {
      padding: var(--space-lg);
    }
  }
</style>
