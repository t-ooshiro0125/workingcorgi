{
  "name": "workingcorgi",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "notes:sync": "tsx --env-file-if-exists=.env scripts/sync-notes.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{scss,astro}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{scss,astro}\" --fix",
    "lint": "npm run lint:code && npm run lint:styles",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .devcontainer .vscode docs scripts src AGENTS.md astro.config.mjs eslint.config.js stylelint.config.mjs package.json .prettierrc.json workingcorgi.code-workspace .github",
    "format:check": "prettier --check .devcontainer .vscode docs scripts src AGENTS.md astro.config.mjs eslint.config.js stylelint.config.mjs package.json .prettierrc.json workingcorgi.code-workspace .github"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "rehype-autolink-headings": "^7.1.0"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "postcss-html": "^2.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
